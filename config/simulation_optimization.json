{
  // 顺序计划的后续目标上限；当前货物和补给不因查询节奏改变而丢失。
  "version": 1,
  // 自动生成搜索预算（真实毫秒）及局部连续失败转全局阈值。
  "spawnFrameBudgetMilliseconds": 2,
  "localPlacementFailureLimit": 8,
  "taskQueue": true,
  // 活跃实体跳过确定的空行为，组件仅在同步批次内复用；可分别关闭作性能对照。
  "activeExecutionPlan": true,
  "activeComponentReuse": true,
  "workerQueueLimit": 12,
  // 单位均为模拟秒，接地/外观检测为真实秒。约2秒检测外部修改；实例化材质开关在新建资源材质时应用。
  "decisionSeconds": 0.25,
  // 短周期食物搜索缓存允许的实体位移，单位为世界距离；资源变化/耗尽即时失效。
  "foodSearchMoveTolerance": 0.1,
  "mateSearchSeconds": 0.5,
  "groundProbeSeconds": 0.2,
  // 生成星球直接定位真实三角形；不支持的碰撞网格回退射线。角度为度，速度差为世界单位/秒。
  "directGroundQueries": true,
  "groundNormalAngleDegrees": 0.15,
  "groundVelocityEpsilon": 0.0001,
  "groundProbeMoveTolerance": 0.1,
  "groundProbeVerticalSpeed": 0.1,
  "resourceCellSize": 32,
  "maximumResourceCells": 4096,
  "expressionCache": true,
  "expressionCacheLimit": 256,
  "localCompetition": true,
  "singletonKernel": true,
  "resourceInstancing": true,
  // 尸体只合并显示提交，保留身份/营养/点选；实例批次大小1～511。
  "corpseBatchRendering": true,
  "corpseBatchSize": 256,
  // 尸体绘制空间格大小；与资源搜索格分开，较大值减少绘制提交。
  "corpseRenderCellSize": 128,
  // 云/大气使用外接低模代理；细分4～128，重载世界时应用。海面和地形碰撞保持精度。
  "weatherProxyMeshes": true,
  // 控制/实体视角的无遮挡天空散射倍率，1～32；不增强实体与近地雾。
  "entitySkyDensityMultiplier": 8,
  "weatherProxySubdivisions": 16,
  "visualRefreshSeconds": 0.25,
  "lightDistance": 80
}
