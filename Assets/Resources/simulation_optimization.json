{
  // 顺序计划的后续目标上限；当前货物和补给不因查询节奏改变而丢失。
  "version": 1,
  "taskQueue": true,
  "workerQueueLimit": 12,
  // 单位均为模拟秒，接地/外观检测为真实秒。约2秒检测外部修改；实例化材质开关在新建资源材质时应用。
  "decisionSeconds": 0.25,
  "mateSearchSeconds": 0.5,
  "groundProbeSeconds": 0.2,
  "groundProbeMoveTolerance": 0.1,
  "groundProbeVerticalSpeed": 0.1,
  "resourceCellSize": 32,
  "maximumResourceCells": 4096,
  "expressionCache": true,
  "expressionCacheLimit": 256,
  "localCompetition": true,
  "singletonKernel": true,
  "resourceInstancing": true,
  "visualRefreshSeconds": 0.25,
  "lightDistance": 80
}
